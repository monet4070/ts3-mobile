set(TS3_APM_ROOT "" CACHE PATH "Explicit standalone APM experiment build root")
if(TS3_APM_ROOT)
    set(APM_SOURCE ${TS3_APM_ROOT}/source/webrtc-audio-processing-1.3)
    set(APM_BUILD ${TS3_APM_ROOT}/${ANDROID_ABI})
    if(NOT EXISTS ${APM_BUILD}/webrtc/modules/audio_processing/libwebrtc-audio-processing-1.a)
        message(FATAL_ERROR "Build the pinned APM experiment for ${ANDROID_ABI} with tools/build-apm-experiment.py first")
    endif()
    file(GLOB_RECURSE APM_ARCHIVES CONFIGURE_DEPENDS ${APM_BUILD}/*.a)
    add_library(ts3apm_experiment SHARED apm_experiment_jni.cpp)
    target_compile_features(ts3apm_experiment PRIVATE cxx_std_17)
    target_compile_options(ts3apm_experiment PRIVATE -Wall -Wextra -Werror)
    target_compile_definitions(ts3apm_experiment PRIVATE WEBRTC_POSIX WEBRTC_ANDROID WEBRTC_LINUX WEBRTC_LIBRARY_IMPL)
    target_include_directories(ts3apm_experiment SYSTEM PRIVATE ${APM_SOURCE}/webrtc ${APM_SOURCE}/subprojects/abseil-cpp-20230125.1)
    target_link_libraries(ts3apm_experiment PRIVATE -Wl,--start-group ${APM_ARCHIVES} -Wl,--end-group log m)
    target_link_options(ts3apm_experiment PRIVATE -Wl,-z,max-page-size=16384 -Wl,--gc-sections)
endif()
