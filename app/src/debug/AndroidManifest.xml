<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".probe.FloatingPttProbeActivity"
            android:exported="false" />

        <activity-alias
            android:name=".probe.FloatingPttLab"
            android:exported="true"
            android:label="@string/ptt_probe_title"
            android:targetActivity=".probe.FloatingPttProbeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".probe.FloatingPttProbeService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="true" />
    </application>
</manifest>
